# =============================================================
# Nexopus Finance Ops — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione .env com secrets reais.
# =============================================================

# ── Banco de Dados ─────────────────────────────────────────
POSTGRES_DB=nexopus
POSTGRES_USER=nexopus
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql+asyncpg://nexopus:change_me_postgres_password@db:5432/nexopus
SYNC_DATABASE_URL=postgresql://nexopus:change_me_postgres_password@db:5432/nexopus

# ── MinIO (Object Storage) ─────────────────────────────────
MINIO_ROOT_USER=nexopus_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=nexopus-docs
AWS_ACCESS_KEY_ID=nexopus_minio
AWS_SECRET_ACCESS_KEY=change_me_minio_password

# ── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=nexopus
RABBITMQ_DEFAULT_PASS=change_me_rabbit_password
RABBITMQ_URL=amqp://nexopus:change_me_rabbit_password@rabbitmq:5672/

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Aplicação (API) ────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_super_secret_key_minimum_32_characters!!
ADMIN_USERNAME=admin@nexopus.com
ADMIN_PASSWORD=Admin@changeme123!
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# EXTRA_USERS_JSON=[{"email":"analista@nexopus.com","password":"pass","role":"analista"}]

# ── AI — GitHub Copilot (Claude Sonnet 4.6 / GPT-5.2) ─────
# Gere em: https://github.com/settings/tokens  (requer acesso Copilot)
GITHUB_AI_TOKEN=ghp_your_token_here
GITHUB_AI_BASE_URL=https://api.githubcopilot.com/chat/completions

# ── AI — Azure Inference (Meta-LLaMA 3.1 405B) ────────────
AZURE_INFERENCE_TOKEN=your_azure_inference_token_here
AZURE_INFERENCE_BASE_URL=https://models.inference.ai.azure.com/chat/completions

# ── Observabilidade — Sentry ───────────────────────────────
# SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxxx
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Observabilidade — OpenTelemetry / Jaeger ───────────────
# OTLP_ENDPOINT=http://jaeger:4317

# ── Celery Flower ──────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flower-change-me!

# ── Frontend (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1

